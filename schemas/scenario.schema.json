{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimbridge.dev/schemas/scenario.schema.json",
  "title": "Scenario registry file (PRD 12.8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "method", "given", "request", "expected", "sandbox", "sourceRefs", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "method": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "given": { "type": "object" },
    "request": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "stateChanges"],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sonucKodu", "sonucMesaji"],
          "properties": {
            "sonucKodu": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "sonucMesaji": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          }
        },
        "stateChanges": { "type": "object" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "httpStatus", "latencyMs"],
      "properties": {
        "deterministic": { "type": "boolean" },
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "latencyMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
    },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  }
}

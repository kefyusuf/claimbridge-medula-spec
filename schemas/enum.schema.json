{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimbridge.dev/schemas/enum.schema.json",
  "title": "Enum registry file (PRD 12.5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "values", "sourceRefs", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "displayName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label", "description"],
        "properties": {
          "code": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
    },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimbridge.dev/schemas/workflow.schema.json",
  "title": "Workflow registry file (PRD 12.7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "steps", "sourceRefs", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "requires", "creates", "updates", "deletes", "next"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "method": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "requires": { "$ref": "common.schema.json#/$defs/stringList" },
          "creates": { "$ref": "common.schema.json#/$defs/stringList" },
          "updates": { "$ref": "common.schema.json#/$defs/stringList" },
          "deletes": { "$ref": "common.schema.json#/$defs/stringList" },
          "next": { "$ref": "common.schema.json#/$defs/stringList" }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
    },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  }
}
